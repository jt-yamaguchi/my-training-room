# ローカル開発用(docker-compose.yml が読む)
# コピーして .env を作成する: cp .env.example .env
DB_NAME=appdb
DB_USER=app
DB_PASSWORD=change-me-local

# ---- 本番(docker-compose.prod.yml)でのみ使用 ----
# 運営から払い出された自分のドメイン(ベース)を設定する。
# アプリは app.${DOMAIN}、LPは lp.${DOMAIN} として自動で組み立てられる。
# この3ドメインはどの課題リポを公開するときも同じ(課題が変わってもDNS・証明書は不変)
DOMAIN=your-name.training.example.com
