  <diagram name="ローカル開発の通信経路" id="local-network">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="l0" />
        <mxCell id="l1" parent="l0" />

        <mxCell id="ln-host" value="ホストOS(Windows)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="l1">
          <mxGeometry x="40" y="40" width="760" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ln-browser" value="ブラウザ&lt;br&gt;Reactはここで実行される" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l1">
          <mxGeometry x="70" y="90" width="240" height="60" as="geometry" />
